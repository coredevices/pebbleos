# --- Build commands --------------------------------------------------------

def cmd_configure(argv):
    """Configure the firmware build directory."""
    parser = argparse.ArgumentParser(prog="pbl configure")
    parser.add_argument("--board", required=True,
                        help="Board to build for, e.g. asterix or obelix@pvt")
    parser.add_argument("--variant", default="normal", choices=["normal", "prf"],
                        help="Build variant (default: normal)")
    parser.add_argument("-G", "--generator", default="Ninja",
                        help="CMake generator (default: Ninja)")
    options, extra = parser.parse_known_args(argv)

    cmd = ["cmake", "-B", BUILD_DIR, "-G", options.generator,
           "-DBOARD=" + options.board, "-DVARIANT=" + options.variant]
    # -DCONFIG_FOO=y overrides are passed straight through to CMake, which
    # hands them to Kconfig.
    cmd += extra
    if os.path.exists(os.path.join(BUILD_DIR, "menuconfig.conf")):
        _pprint("YELLOW", "Using the Kconfig changes from build/menuconfig.conf")
    return _run(cmd)


def cmd_build(argv):
    """Build the firmware, or the named targets."""
    cmd = ["cmake", "--build", BUILD_DIR]
    for target in argv:
        cmd += ["--target", target]
    return _run(cmd)


def cmd_test(argv):
    """Build and run the unit tests, then hand the rest to ctest."""
    parser = argparse.ArgumentParser(prog="pbl test", add_help=False)
    parser.add_argument("-G", "--generator", default="Ninja",
                        help="CMake generator (default: Ninja)")
    parser.add_argument("-C", "--coverage", action="store_true",
                        help="Instrument the tests and write an lcov report")
    parser.add_argument("--no-images", action="store_true",
                        help="Skip the image fixtures; only some tests need them")
    parser.add_argument("--build-only", action="store_true",
                        help="Build the tests without running them")
    parser.add_argument("-h", "--help", action="store_true",
                        help="Show this help, and ctest's")
    options, extra = parser.parse_known_args(argv)

    if options.help:
        parser.print_help()
        print("\nEverything else is passed to ctest:\n")
        sys.stdout.flush()
        return subprocess.call(["ctest", "--help"])

    rc = _run(["cmake", "-B", TEST_DIR, "-S", "tests", "-G", options.generator,
               "-DPBL_TEST_COVERAGE=" + ("ON" if options.coverage else "OFF"),
               "-DPBL_TEST_IMAGES=" + ("OFF" if options.no_images else "ON")])
    if rc:
        return rc
    rc = _run(["cmake", "--build", TEST_DIR])
    if rc or options.build_only:
        return rc

    # ctest runs one test per core unless told otherwise, and always
    # leaves a JUnit report behind for CI to pick up.
    cmd = ["ctest", "--test-dir", TEST_DIR, "--output-on-failure",
           "--output-junit", os.path.join(TEST_DIR, "junit.xml")]
    if not any(a == "-j" or a.startswith("-j") or a == "--parallel" for a in extra):
        cmd += ["-j", str(os.cpu_count() or 1)]
    rc = _run(cmd + extra)

    if options.coverage:
        rc = _lcov_report() or rc
    return rc


def _lcov_report():
    """Turn the gcov data the run produced into lcov.info and a HTML report."""
    info = os.path.join(TEST_DIR, "lcov.info")
    extra = ["--gcov-tool", "llvm-cov"] if sys.platform.startswith("linux") else []
    html = os.path.join(TEST_DIR, "lcov-html")
    steps = [
        ["lcov", "--capture", "--directory", TEST_DIR, "--output-file", info] + extra,
        # The tests themselves are not what the report is about.
        ["lcov", "--remove", info, "tests/**", "-o", info] + extra,
        ["genhtml", info, "--output-directory", html],
    ]
    for step in steps:
        rc = _run(step)
        if rc:
            _pprint("RED", "Coverage report failed; are lcov and genhtml installed?")
            return rc
    _pprint("GREEN", f"Coverage report at {html}/index.html")
    return 0


def cmd_bundle(argv):
    return _build_target("bundle")


def cmd_clean(argv):
    return _build_target("clean")


def cmd_menuconfig(argv):
    """Edit the configuration interactively, then reconfigure with it."""
    dotconfig = os.path.join(BUILD_DIR, ".config")
    if not os.path.isfile(dotconfig):
        _fatal("Build not configured -- run ./pbl configure --board BOARD first.")

    env = load_env()
    environ = os.environ.copy()
    environ["srctree"] = REPO_ROOT
    environ["BOARD"] = env.BOARD_NAME
    environ["BOARD_REVISION"] = env.BOARD_REVISION or "_"
    environ["KCONFIG_CONFIG"] = dotconfig
    subprocess.run([sys.executable, "-m", "menuconfig",
                    os.path.join(REPO_ROOT, "Kconfig")],
                   env=environ, check=False)

    # Keep the edited configuration across reconfigurations: it is applied
    # on top of the board's defconfig. Delete it to go back to the defaults.
    saved = os.path.join(BUILD_DIR, "menuconfig.conf")
    with open(dotconfig) as src, open(saved, "w") as dst:
        dst.write(src.read())
    return _run(["cmake", BUILD_DIR])


