# --- Colored output -------------------------------------------------------

def _pprint(color, msg):
    codes = {"RED": "31", "GREEN": "32", "YELLOW": "33", "CYAN": "36"}
    sys.stdout.write("\033[%sm%s\033[0m\n" % (codes.get(color, "0"), msg))


def _fatal(msg):
    _pprint("RED", msg)
    sys.exit(1)


def _run_shell(cmd):
    """Run a shell command string, honoring --dry-run."""
    if _DRY_RUN:
        _pprint("YELLOW", "[dry-run] " + cmd)
        return 0
    return subprocess.call(cmd, shell=True)


def _run(cmd):
    """Run a command from the repository root, honoring --dry-run."""
    if _DRY_RUN:
        _pprint("YELLOW", "[dry-run] " + " ".join(cmd))
        return 0
    return subprocess.call(cmd, cwd=REPO_ROOT)


def _build_target(*targets):
    """Build one of the firmware's targets (e.g. a QEMU flash image)."""
    cmd = ["cmake", "--build", BUILD_DIR]
    for target in targets:
        cmd += ["--target", target]
    return _run(cmd)


# --- Configured build env -------------------------------------------------

class Env:
    """The configured build's settings. Missing keys read back as an empty
    list, the ConfigSet semantics the runner helpers were written against."""

    def __init__(self, data):
        self._data = data

    def __getattr__(self, key):
        return self._data.get(key, [])

    def __getitem__(self, key):
        return self._data.get(key, [])

    def __contains__(self, key):
        return key in self._data


def load_env():
    path = os.path.join(BUILD_DIR, "pbl_env.json")
    if not os.path.isfile(path):
        _fatal("Build not configured -- run ./pbl configure --board BOARD first.")
    import json

    with open(path) as f:
        return Env(json.load(f))


