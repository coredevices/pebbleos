mbedtls_includes = [
    'mbedtls/include',
    'include',
]

mbedtls_env = bld.env.derive()

mbedtls_env.append_value('CFLAGS', [
    '-Wno-unused-but-set-variable',
])

bld.pbl_include_directories(*mbedtls_includes)
bld.pbl_compile_definitions('MBEDTLS_CONFIG_FILE="pebble_mbedtls_config.h"')

bld.pbl_library(
    bld.path.ant_glob('mbedtls/library/*.c'),
    name='mbedtls',
    includes=['mbedtls/library'],
    env=mbedtls_env,
)
