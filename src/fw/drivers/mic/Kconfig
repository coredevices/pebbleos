menuconfig MIC
    bool "Microphone"
    help
      Microphone Drivers

if MIC

config MIC_NRF5
    bool "Nordic nRF5 PDM"
    default y if SOC_NRF52
    select HAL_NORDIC
    help
      Support for the Nordic nRF5 PDM microphone interface.

config MIC_SF32LB
    bool "SiFli SF32LB PDM"
    default y if SOC_SF32LB52
    select HAL_SIFLI
    select HAL_SIFLI_AUDCODEC
    select HAL_SIFLI_PDM
    help
      Support for the SiFli SF32LB PDM microphone interface.

config MIC_QEMU
    bool "QEMU stub"
    default y if SOC_QEMU
    help
      Software-only microphone stub for QEMU. Delivers silence at
      MIC_SAMPLE_RATE so the voice service can run end-to-end against
      `pebble transcribe`, which ignores audio frames and replies with
      a canned transcription on a timer.

module = DRIVER_MIC
module-str = Microphone
source "subsys/logging/Kconfig.template.log_level"

endif # MIC
