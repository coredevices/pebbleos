if bld.env.CONFIG_MPU_TYPE_ARMV8M:
    mpu_arch_source = 'mpu/mpu_armv8m.c'
else:
    mpu_arch_source = 'mpu/mpu_armv7m.c'
bld.pbl_library(['mpu.c', mpu_arch_source], name='driver_mpu')

bld.pbl_library(['task_watchdog.c'], name='driver_task_watchdog')

if bld.env.CONFIG_QEMU:
    bld.pbl_library(['qemu/qemu_button.c'], name='driver_button')
    bld.pbl_library(['stubs/mcu.c'], name='driver_mcu')
    bld.pbl_library(['qemu/qemu_serial.c', 'qemu/qemu_serial_util.c'], name='driver_qemu_serial')
    bld.pbl_library(['qemu/qemu_settings.c'], name='driver_qemu_settings')
    bld.pbl_library(['stubs/ambient_light.c', 'qemu/qemu_vibe.c', 'stubs/otp.c'],
                    name='driver_qemu_stubs')
    bld.pbl_library_ifdef('CONFIG_MAG', ['imu/mag3110/mag3110.c'], name='driver_mag3110')
elif bld.env.CONFIG_SOC_NRF52:
    bld.pbl_library(['nrf5/button.c', 'nrf5/debounced_button.c'], name='driver_button')
    # FIXME: provide working implementation
    bld.pbl_library(['stubs/mcu.c'], name='driver_mcu')
    bld.pbl_library(['nrf5/qspi.c'], name='driver_qspi')
    bld.pbl_library(['nrf5/hfxo.c'], name='driver_nrf5_hfxo')
elif bld.env.CONFIG_SOC_SF32LB52:
    bld.pbl_library(['sf32lb52/button.c', 'sf32lb52/debounced_button.c'], name='driver_button')
    bld.pbl_library(['sf32lb52/mcu.c'], name='driver_mcu')
    bld.pbl_library(['sf32lb52/qspi.c'], name='driver_qspi')
    bld.pbl_library(['sf32lb52/rc10k.c'], name='driver_rc10k')

