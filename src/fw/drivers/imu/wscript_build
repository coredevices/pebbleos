# Accelerometer

accel_sources = []

if bld.env.CONFIG_QEMU:
    accel_sources.append('../qemu/qemu_accel.c')
elif bld.env.CONFIG_ACCEL_LIS2DW12:
    accel_sources.append('lis2dw12/lis2dw12.c')
elif bld.env.CONFIG_ACCEL_LSM6DSO:
    accel_sources.append('lsm6dso/lsm6dso.c')

if accel_sources:
    bld.pbl_library(accel_sources, name='driver_accel')

# Magnetometer

mag_sources = []

if bld.env.CONFIG_MAG_MMC5603NJ:
    mag_sources.append('mmc5603nj/mmc5603nj.c')

if mag_sources:
    bld.pbl_library(mag_sources, name='driver_mag')
