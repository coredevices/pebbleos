if bld.variant != 'test':
    # assert.c overrides __assert_func, the assert() hook of the
    # newlib-family <assert.h>; syscalls.c overrides _sbrk since the
    # firmware owns all heaps via --wrap=malloc -> pbl_malloc.
    bld.pbl_library(['assert.c', 'syscalls.c'])

    # newlib-nano's printf lacks C99 length modifiers; provide a shim.
    if bld.env.CONFIG_LIBC_NEWLIB_NANO:
        bld.recurse('newlib')

