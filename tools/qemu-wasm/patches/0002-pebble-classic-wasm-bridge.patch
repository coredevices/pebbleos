+#ifdef __EMSCRIPTEN__
+    /* Coalesced persistence for the wasm build (see pflash_wasm_flush) */
+    int64_t wasm_dirty_start;
+    int64_t wasm_dirty_end;
+    QEMUTimer *wasm_flush_timer;
+#endif
 };
 
 /*
@@ -403,22 +409,66 @@ static uint64_t pflash_read(void *opaque, hwaddr offset, unsigned int width)
     return ret;
 }
 
+#ifdef __EMSCRIPTEN__
+/*
+ * Synchronous blk_pwrite() from the vCPU thread polls the main AioContext
+ * from outside its home thread, which the wasm fiber/asyncify runtime
+ * cannot support (aio_poll home-thread assertion). Instead, accumulate a
+ * dirty range and persist it from a main-loop timer, where the sync write
+ * is legal. pfl->storage stays authoritative in between.
+ */
+static void pflash_wasm_flush(void *opaque)
+{
+    PFlashCFI02 *pfl = opaque;
+    int64_t start = pfl->wasm_dirty_start;
+    int64_t end = pfl->wasm_dirty_end;
+    int ret;
+
+    pfl->wasm_dirty_start = -1;
+    pfl->wasm_dirty_end = -1;
+    if (start < 0 || !pfl->blk) {
+        return;
+    }
+    ret = blk_pwrite(pfl->blk, start, end - start,
+                     (uint8_t *)pfl->storage + start, 0);
+    if (ret < 0) {
+        error_report("Could not update PFLASH: %s", strerror(-ret));
+    }
+}
+#endif
+
 /* update flash content on disk */
 static void pflash_update(PFlashCFI02 *pfl, int offset, int size)
 {
     int offset_end;
+#ifndef __EMSCRIPTEN__
     int ret;
+#endif
     if (pfl->blk) {
         offset_end = offset + size;
         /* widen to sector boundaries */
         offset = QEMU_ALIGN_DOWN(offset, BDRV_SECTOR_SIZE);
         offset_end = QEMU_ALIGN_UP(offset_end, BDRV_SECTOR_SIZE);
+#ifdef __EMSCRIPTEN__
+        if (pfl->wasm_dirty_start < 0) {
+            timer_mod(pfl->wasm_flush_timer,
+                      qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 100);
+            pfl->wasm_dirty_start = offset;
+            pfl->wasm_dirty_end = offset_end;
+        } else {
+            pfl->wasm_dirty_start = MIN(pfl->wasm_dirty_start,
+                                        (int64_t)offset);
+            pfl->wasm_dirty_end = MAX(pfl->wasm_dirty_end,
+                                      (int64_t)offset_end);
+        }
+#else
         ret = blk_pwrite(pfl->blk, offset, offset_end - offset,
                          pfl->storage + offset, 0);
         if (ret < 0) {
             /* TODO set error bit in status */
             error_report("Could not update PFLASH: %s", strerror(-ret));
         }
+#endif
     }
 }
 
