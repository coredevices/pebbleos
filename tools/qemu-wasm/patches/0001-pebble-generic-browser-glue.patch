+            case MO_SW: { uint16_t v; memcpy(&v, haddr, 2); return (int16_t)v; }
+            case MO_UL: { uint32_t v; memcpy(&v, haddr, 4); return v; }
+            case MO_SL: { uint32_t v; memcpy(&v, haddr, 4); return (int32_t)v; }
